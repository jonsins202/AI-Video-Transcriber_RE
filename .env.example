# OpenAI API Configuration
# Get your API key from: https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here

# Optional: Custom OpenAI Base URL (for proxy or alternative endpoints)
OPENAI_BASE_URL=https://api.openai.com/v1

# Server Configuration (Optional)
HOST=0.0.0.0
PORT=8000

# ASR backend: funasr (default, FunASR SenseVoice/Paraformer) | qwen (Qwen3-ASR fallback) | dashscope (cloud ASR)
ASR_BACKEND=funasr

# FunASR (default ASR)
FUNASR_MODEL=paraformer        # paraformer(默认,中文旗舰+自带标点) | sensevoice(多语言+情绪检测,中英混杂场景)
FUNASR_DEVICE=cuda
FUNASR_VAD_MODEL=fsmn-vad
FUNASR_BATCH_SIZE_S=300
# FUNASR_LANG=                  # 留空自动检测；可填 zh/en
# FUNASR_HOTWORD=               # 热词(空格分隔,仅 paraformer 生效,如:AGI 张三)

# Qwen3-ASR (fallback ASR, used when ASR_BACKEND=qwen)
# QWEN3_ASR_MODEL_PATH=./models/Qwen3-ASR-0.6B

# DashScope cloud ASR (used when ASR_BACKEND=dashscope)
# 音频先上传 OSS 生成签名 URL，再提交异步转写任务，完成后自动删除 OSS 对象
# DASHSCOPE_API_KEY=sk-xxx      # 百炼 API Key
# DASHSCOPE_WORKSPACE=          # 业务空间 ID（决定接入点域名，如 llm-xxxx）
# DASHSCOPE_REGION=cn-beijing
# DASHSCOPE_ASR_MODEL=qwen-audio-3.0-asr-flash-filetrans
# DASHSCOPE_DIARIZATION=        # 默认 1（开，自动聚类识别人数，无需预填）；=0 关闭
# DASHSCOPE_CHUNK_MAX_MIN=110   # 开分离时单片上限（分钟，官方建议 ≤2h）；超长自动带重叠切片并发转写
# DASHSCOPE_CHUNK_OVERLAP_S=30  # 切片重叠（秒），用于接缝去重 + 说话人跨片匹配
# DASHSCOPE_LANGUAGE_HINTS=zh,en
# OSS_BUCKET=
# OSS_ENDPOINT=oss-cn-beijing.aliyuncs.com
# OSS_ACCESS_KEY_ID=
# OSS_ACCESS_KEY_SECRET=

# SKIP_OPTIMIZE=1               # 跳过「无损优化」LLM 阶段（云端 ASR 自带标点、错字少时省一次 LLM 调用）

# Local upload size limit in MB (optional; Docker Compose passes this through)
UPLOAD_MAX_MB=200
